# scripts/install_was_rocky8.sh 실행 시 모든 값이 자동 생성됩니다.
# 수동으로 설정할 경우 아래 항목을 채워주세요.
#
# ★ 앱 설정(app/config.py Settings)은 정의되지 않은 키를 거부한다(extra_forbidden).
#   여기 없는 키를 .env 에 넣으면 기동 시 ValidationError 로 워커가 부팅에 실패한다.
#   (예: DB 비밀번호는 DB_PASSWORD 가 아니라 DATABASE_URL 안에 넣는다)

DATABASE_URL=postgresql://soltrace:<DB비밀번호>@127.0.0.1:5432/soltrace
SECRET_KEY=
ADMIN_PASSWORD=

# ── 서비스 영향도 알림 (선택) ────────────────────────────────────────────────
# 미설정 시 알림은 웹 UI에만 표시됩니다. 임계값은 기본값이 있어 비워도 됩니다.
# ALERTS_ENABLED=true
# ALERT_BUCKET_MINUTES=10
# ALERT_BASELINE_DAYS=7
# ALERT_MAD_K=4.0
# ALERT_FAIL_RATE_FLOOR=0.05
# ALERT_LOGIN_FAIL_RATE_FLOOR=0.30
# ALERT_THROUGHPUT_DROP=0.6
# 평소 속도의 하위 이 분위보다 느릴 때만 알림 — 사용자별 회선 대역폭 차이로
# 평소에도 느린 구간이 있는 장비는 임계가 자동으로 내려간다.
# ALERT_THROUGHPUT_SLOW_PCT=0.05
# 전송 속도 판정 대상 — 이 크기 이상의 성공 전송만 집계 (작은 파일 대량 전송 오탐 방지).
# 롤업에 반영되는 값이라 변경 시 baseline 이 다시 쌓일 때까지 보수적으로 동작한다.
# ALERT_LARGE_FILE_BYTES=4194304
# ALERT_MIN_LARGE_SAMPLES=5
# 위 두 값을 제외한 임계값은 설정 페이지에서 조정하며, 여기 값은 기본값으로만 쓰인다.
# 웹훅 알림 (Slack/사내 시스템 등 JSON POST 수신 URL)
# ALERT_WEBHOOK_URL=https://hooks.example.com/soltrace
# HMS 메일 게이트웨이 URL (SMTP 직접 발송은 지원하지 않음)
# ALERT_HMS_URL=
