[Unit]
Description=SolTrace FTP Log Daemon
After=network-online.target proftpd.service
Wants=network-online.target
PartOf=proftpd.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=soltrace
Group=soltrace
WorkingDirectory=/opt/soltrace-daemon
ExecStart=/opt/soltrace-daemon/venv/bin/python3 soltrace_daemon.py

# 자가 업데이트 후 데몬이 스스로 종료(exit 42)해 여기서 다시 뜬다.
# 데몬은 User=soltrace 비특권 프로세스라 systemctl restart 를 스스로 호출할 수 없다.
# 그래서 on-failure 를 없애거나 42 를 SuccessExitStatus 에 넣으면 자가 업데이트가 멈춘다.
# exit 1 은 복구 불가 상황(안전 종료)이라 RestartPreventExitStatus 로 재시작을 막는다.
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=1

TimeoutStartSec=30
TimeoutStopSec=15

# ── 보안 하드닝 (Rocky 8 / systemd 239+) ────────────────────────
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
# ProtectSystem 미사용: /usr/service가 별도 마운트일 경우 /usr bind mount가 submount를 숨김
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes

# /var/log/soltrace-daemon 을 데몬 계정 소유로 자동 생성 (로그 파일 회전에 디렉터리 쓰기 권한 필요)
LogsDirectory=soltrace-daemon
LogsDirectoryMode=0750

StandardOutput=journal
StandardError=journal
SyslogIdentifier=soltrace-daemon

MemoryMax=64M
CPUQuota=10%
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
