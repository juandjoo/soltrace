[daemon]
# ────────────────────────────────────────────────────────────────
# WAS 연결
# ────────────────────────────────────────────────────────────────

# WAS 서버 주소 (http/https 모두 가능)
was_url = https://soltrace.mbone.net

# 웹 UI에서 "데몬 업데이트" 버튼 클릭 시 파일을 받아올 URL (GitHub raw)
update_url = https://raw.githubusercontent.com/juandjoo/soltrace/main/ftp-daemon

# HTTP 연결 타임아웃 (초) - 네트워크 지연 감안하여 15초 권장
http_timeout = 15

# ────────────────────────────────────────────────────────────────
# proftpd 로그 파일 경로
# ────────────────────────────────────────────────────────────────

transfer_log = /usr/service/logs/proftpd/TransferLog
extended_log = /usr/service/logs/proftpd/ExtendedAllLog

# ────────────────────────────────────────────────────────────────
# 전송 성능
# ────────────────────────────────────────────────────────────────

# 한 번에 전송할 최대 건수
# - 200 권장 (WAS 버퍼가 묶어서 DB에 쓰므로 크게 설정해도 부하 낮음)
# - 대용량(초당 수십 건 이상)이면 500까지 조정 가능
batch_size = 200

# 로그 파일 폴링 주기 (초)
# - 10초: 권장 (WAS 부하와 실시간성 균형)
# - 5초: 준실시간 필요 시 / 30초: 자원 절약 모드
poll_interval = 10

# ────────────────────────────────────────────────────────────────
# 재전송 정책
# ────────────────────────────────────────────────────────────────

# 한 요청의 최대 재시도 횟수 (이 횟수를 모두 실패하면 버퍼에 저장하고 백오프)
retry_max = 3

# 재시도 간격 (초) - WAS 회복 대기 시간
retry_delay = 10

# ────────────────────────────────────────────────────────────────
# 버퍼 (전송 실패 시 임시 저장)
# ────────────────────────────────────────────────────────────────

# 실패 항목 저장 경로
buffer_file = /var/lib/soltrace/buffer.jsonl

# 버퍼 최대 보관 줄 수 (초과 시 오래된 항목부터 삭제)
# - 디스크 용량 보호 목적, 0 = 무제한
max_buffer_lines = 50000

# ────────────────────────────────────────────────────────────────
# 하트비트
# ────────────────────────────────────────────────────────────────

# WAS에 장비 생존 신호 전송 주기 (초)
# - 60초 권장 (상태값은 변화 있을 때만 포함되어 payload 자동 최소화)
heartbeat_interval = 60

# ────────────────────────────────────────────────────────────────
# 상태 파일 (위치 추적, 중복 전송 방지)
# ────────────────────────────────────────────────────────────────

state_dir = /var/lib/soltrace

# ────────────────────────────────────────────────────────────────
# 로그
# ────────────────────────────────────────────────────────────────

log_file  = /var/log/soltrace-daemon/daemon.log

# DEBUG: 전송 건수 등 상세 출력 / INFO: 기본 / WARNING: 이상 시만
log_level = INFO

# 로그 파일 자동 회전 (logrotate 불필요 — 데몬이 직접 처리)
# - log_max_mb 를 넘으면 .1, .2 ... 로 밀어내며 오래된 것부터 삭제
# - 최대 디스크 사용량 = log_max_mb x (log_backup_count + 1)  = 기본 60MB
# - log_max_mb = 0 이면 회전하지 않음(무제한 증가 — 권장하지 않음)
log_max_mb = 10
log_backup_count = 5

# ────────────────────────────────────────────────────────────────
# 필터
# ────────────────────────────────────────────────────────────────

# true: 로그인/로그아웃 이벤트를 WAS로 전송하지 않음 (파일 전송 이벤트만 기록)
skip_login_logout = false

# ────────────────────────────────────────────────────────────────
# 업로드 자동 purge (선택 — 쓰는 장비만)
# ────────────────────────────────────────────────────────────────
# 어느 FTP 계정의 업로드를 purge 할지는 WAS 의 그룹 설정(업로드 자동 purge)에서 정한다.
# 여기에는 경로 규칙과 PURGE 를 보낼 서버 IP 만 둔다. 이 절이 없으면 purge 는 꺼져 있다.
# 처음에는 dry_run = true 로 두고 데몬 로그에 찍히는 PURGE URL 이 맞는지 먼저 확인한다.
# (줄 끝 주석은 값에 섞이므로 쓰지 않는다)
#
# [purge]
# 경로가 strip_prefix 로 시작하면 그 다음 폴더(계정 ID)까지 떼어 CDN 경로로 쓴다
# 예) /mnt1/8000000000000004549/cjenm/CLIP/a.mp4 → cjenm/CLIP/a.mp4
# strip_prefix = /mnt1
# 실패한 서버만 다시 보내는 횟수와 간격(초)
# retry        = 3
# retry_delay  = 5
# timeout      = 10
# dry_run      = false
#
# 규칙 — [purge:<이름>] 절마다 하나, 위에서부터 처음 맞는 규칙을 쓴다.
#   match       : CDN 경로 접두어 (쉼표로 여러 개)
#   parent_ips  : (선택) 먼저 지울 부모 서버 IP — 하나라도 끝내 실패하면 엣지는 건너뛴다
#   edge_ips    : 엣지 서버 IP
#                 (IP 는 쉼표·공백·줄바꿈 어느 것으로 나눠도 된다. 여러 줄이면 다음 줄을 들여쓴다)
#   *_url       : {ip}, {path} 자리표시자. edge_url_smil 은 경로에 .smil 이 있을 때 쓴다
#   host        : PURGE 요청의 Host 헤더
#
# [purge:clip]
# match         = cjenm/CLIP/
# edge_ips      = 10.0.0.1, 10.0.0.2
# edge_url      = http://{ip}:61800/smc/naver/single/eng/0/{path}/content.mp4
# edge_url_smil = http://{ip}:61800/smc/naver/single/eng/0/{path}
#
# [purge:vod]
# match      = VOD/
# parent_ips = 10.0.1.1
# parent_url = http://{ip}:61800/{path}
# edge_ips   = 10.0.1.11
#              10.0.1.12
# edge_url   = http://{ip}:61800/{path}
# host       = vod-cjvod.lgucdn.com
#
# [purge:movie]
# match    = inisoft/MOVIE/
# edge_ips = 10.0.2.1
# edge_url = http://{ip}:61800/{path}/playlist.m3u8
# host     = movie-cjmovie.lgucdn.com
